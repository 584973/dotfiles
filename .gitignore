.DS_Store
node_modules/
.env
.env.*
!.env.example

# Ignore Neovim swap, backup, and undo files
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*.log

# Ignore session files
Session.vim

# Ignore undo files (if you're using persistent undo)
**/undodir/*

# Ignore backup files (if you're using Neovim's built-in backup system)
**/backup/*

# Ignore directory specific to plugin managers like packer, lazy, etc.
**/packer_compiled.lua
# **/lazy-lock.json

# Ignore files from plugin installations or external packages
site/pack/*/start/*
site/pack/*/opt/*

# Ignore log files
**/nvim.log
erl_crash.dump

# Ignore Lua language server related files
.nvimspector/
.cache/nvim/

# Zed runtime-generated files
zed/.config/zed/prompts/
zed/.config/zed/themes/
zed/.config/zed/conversations/
zed/.config/zed/contexts/

# Pi runtime and sensitive files
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
pi/.pi/agent/bin/
pi/.pi/agent/extensions/*
pi/.pi/agent/logs/

# Allow the pi-permission-system user config (tracked policy)
!pi/.pi/agent/extensions/pi-permission-system/
!pi/.pi/agent/extensions/pi-permission-system/config.json

# Allow custom pi extensions
!pi/.pi/agent/extensions/protected-paths.ts
!pi/.pi/agent/extensions/chatgpt-models.ts

