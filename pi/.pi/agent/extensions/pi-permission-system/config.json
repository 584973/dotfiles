    "external_directory": "ask",
    "ls": "allow",
    "find": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find --version": "allow",
      "find *": "allow",
      "find *-exec*": "ask",
      "find *-ok*": "ask",
      "find *-delete*": "ask",
      "grep --version": "allow",
      "rg --version": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --stat -- *": "allow",
      "git diff --name-only": "allow",
      "git diff --name-only -- *": "allow",
      "git diff --name-status": "allow",
      "git diff --check": "allow",
      "git diff -- *": "allow",
      "git diff --cached": "allow",
      "git diff --cached --stat": "allow",
      "git diff --cached --name-only": "allow",
      "git diff --cached --check": "allow",
      "git diff --cached -- *": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git log --oneline -10": "allow",
      "git log --oneline -20": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch -vv": "allow",
      "git remote -v": "allow",
      "git show --stat *": "allow",
      "git show --name-only *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "wc -l *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tmux -V": "allow",
      "nvim --headless *checkhealth*": "allow",
      "git -C * status": "allow",
      "git -C * status *": "allow",
      "git -C * diff": "allow",
      "git -C * diff --stat": "allow",
      "git -C * diff --name-only": "allow",
      "git -C * diff --name-status": "allow",
      "git -C * diff --check": "allow",
      "git -C * diff --cached": "allow",
      "git -C * diff --cached --stat": "allow",
      "git -C * diff --cached --name-only": "allow",
      "git -C * diff --cached --check": "allow",
      "git -C * diff -- *": "allow",
      "git -C * diff --cached -- *": "allow",
      "git -C * log": "allow",
      "git -C * log --oneline": "allow",
      "git -C * log --oneline -10": "allow",
      "git -C * log --oneline -20": "allow",
      "git -C * branch": "allow",
      "git -C * branch --show-current": "allow",
      "stow -n*": "allow",
      "npm list *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "*$(*": "ask",
      "*`*": "ask",
      "npm config ls*": "deny",
      "npm config list*": "deny",
      "npm c ls*": "deny",
      "npm c list*": "deny",
      "npm config get *_auth*": "deny",
      "npm config get *authToken*": "deny",
      "npm config get *token*": "deny",
      "npm get *_auth*": "deny",
      "npm get *authToken*": "deny",
      "npm get *token*": "deny"
    }
  }
}
