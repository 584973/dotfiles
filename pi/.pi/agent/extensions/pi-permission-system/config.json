{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "*/auth.json": "deny"
    },
    "external_directory": "ask",
    "ls": "allow",
    "find": "allow",
    "read": "allow",
    "grep": "allow",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find --version": "allow",
      "grep --version": "allow",
      "rg --version": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --stat -- *": "allow",
      "git diff --name-only": "allow",
      "git diff --name-only -- *": "allow",
      "git diff --name-status": "allow",
      "git diff --check": "allow",
      "git diff -- *": "allow",
      "git diff --cached": "allow",
      "git diff --cached --stat": "allow",
      "git diff --cached --name-only": "allow",
      "git diff --cached --check": "allow",
      "git diff --cached -- *": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git log --oneline -10": "allow",
      "git log --oneline -20": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git -C * status": "allow",
      "git -C * status *": "allow",
      "git -C * diff": "allow",
      "git -C * diff --stat": "allow",
      "git -C * diff --name-only": "allow",
      "git -C * diff --name-status": "allow",
      "git -C * diff --check": "allow",
      "git -C * diff --cached": "allow",
      "git -C * diff --cached --stat": "allow",
      "git -C * diff --cached --name-only": "allow",
      "git -C * diff --cached --check": "allow",
      "git -C * diff -- *": "allow",
      "git -C * diff --cached -- *": "allow",
      "git -C * log": "allow",
      "git -C * log --oneline": "allow",
      "git -C * log --oneline -10": "allow",
      "git -C * log --oneline -20": "allow",
      "git -C * branch": "allow",
      "git -C * branch *": "ask",
      "git -C * branch --show-current": "allow",
      "stow -n*": "allow",
      "npm list *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*\n*": "ask",
      "git add *": "ask",
      "git -C * add *": "ask",
      "git commit *": "ask",
      "git -C * commit *": "ask",
      "git push *": "ask",
      "git -C * push *": "ask",
      "git pull *": "ask",
      "git -C * pull *": "ask",
      "git fetch *": "ask",
      "git -C * fetch *": "ask",
      "git reset *": "ask",
      "git -C * reset *": "ask",
      "git checkout *": "ask",
      "git -C * checkout *": "ask",
      "git switch *": "ask",
      "git -C * switch *": "ask",
      "git restore *": "ask",
      "git -C * restore *": "ask",
      "git clean *": "ask",
      "git -C * clean *": "ask",
      "git stash *": "ask",
      "git -C * stash *": "ask",
      "git merge *": "ask",
      "git -C * merge *": "ask",
      "git rebase *": "ask",
      "git -C * rebase *": "ask",
      "git cherry-pick *": "ask",
      "git -C * cherry-pick *": "ask",
      "git revert *": "ask",
      "git -C * revert *": "ask",
      "git apply *": "ask",
      "git -C * apply *": "ask",
      "git am *": "ask",
      "git -C * am *": "ask",
      "git tag *": "ask",
      "git -C * tag *": "ask",
      "git branch -d *": "ask",
      "git branch -D *": "ask",
      "git branch -m *": "ask",
      "git -C * branch -d *": "ask",
      "git -C * branch -D *": "ask",
      "git -C * branch -m *": "ask",
      "git clone *": "ask",
      "git init *": "ask",
      "git -C * init *": "ask",
      "rm *": "ask",
      "rm -r *": "ask",
      "rm -R *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm --recursive *": "ask",
      "* rm *": "ask",
      "* rm -r *": "ask",
      "* rm -R *": "ask",
      "* rm -rf *": "ask",
      "* rm -fr *": "ask",
      "* rm --recursive *": "ask",
      "dd *": "ask",
      "* dd *": "ask",
      "mkfs *": "ask",
      "mkfs.* *": "ask",
      "* mkfs *": "ask",
      "* mkfs.* *": "ask",
      "* > /dev/sd*": "ask",
      "*>/dev/sd*": "ask",
      "* > /dev/nvme*": "ask",
      "*>/dev/nvme*": "ask",
      "* > /dev/mmcblk*": "ask",
      "*>/dev/mmcblk*": "ask"
    }
  }
}
