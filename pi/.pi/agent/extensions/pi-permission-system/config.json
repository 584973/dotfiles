{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "*/auth.json": "deny"
    },
    "external_directory": "ask",
    "ls": "allow",
    "find": "allow",
    "read": "allow",
    "grep": "allow",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find --version": "allow",
      "grep --version": "allow",
      "rg --version": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --stat -- *": "allow",
      "git diff --name-only": "allow",
      "git diff --name-only -- *": "allow",
      "git diff --name-status": "allow",
      "git diff --check": "allow",
      "git diff -- *": "allow",
      "git diff --cached": "allow",
      "git diff --cached --stat": "allow",
      "git diff --cached --name-only": "allow",
      "git diff --cached --check": "allow",
      "git diff --cached -- *": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git log --oneline -10": "allow",
      "git log --oneline -20": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "stow -n*": "allow",
      "npm list *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*\n*": "ask",
      "rm *": "ask",
      "rm -r *": "ask",
      "rm -R *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm --recursive *": "ask",
      "* rm *": "ask",
      "* rm -r *": "ask",
      "* rm -R *": "ask",
      "* rm -rf *": "ask",
      "* rm -fr *": "ask",
      "* rm --recursive *": "ask",
      "dd *": "ask",
      "* dd *": "ask",
      "mkfs *": "ask",
      "mkfs.* *": "ask",
      "* mkfs *": "ask",
      "* mkfs.* *": "ask",
      "* > /dev/sd*": "ask",
      "*>/dev/sd*": "ask",
      "* > /dev/nvme*": "ask",
      "*>/dev/nvme*": "ask",
      "* > /dev/mmcblk*": "ask",
      "*>/dev/mmcblk*": "ask"
    }
  }
}
