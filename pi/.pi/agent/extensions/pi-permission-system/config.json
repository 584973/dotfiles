{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permissionReviewLog": false,
  "permission": {
    "*": "ask",
    "ask_user_question": "allow",
    "skill": "allow",
    "subagent": "allow",
    "path": {
      "*": "allow",
      "/dev/sd*": "ask",
      "/dev/nvme*": "ask",
      "/dev/mmcblk*": "ask",
      "/dev/disk*": "ask",
      "/dev/rdisk*": "ask",
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*": "deny",
      ".envrc": "deny",
      "*/.envrc": "deny",
      ".netrc": "deny",
      "*/.netrc": "deny",
      ".npmrc": "deny",
      "*/.npmrc": "deny",
      ".yarnrc": "deny",
      "*/.yarnrc": "deny",
      ".pnpmrc": "deny",
      "*/.pnpmrc": "deny",
      ".pypirc": "deny",
      "*/.pypirc": "deny",
      ".pgpass": "deny",
      "*/.pgpass": "deny",
      ".my.cnf": "deny",
      "*/.my.cnf": "deny",
      "auth.json": "deny",
      "*/auth.json": "deny",
      "settings.xml": "deny",
      "*/settings.xml": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.crt": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.cer": "deny",
      "*.der": "deny",
      "id_rsa": "deny",
      "*/id_rsa": "deny",
      "id_ed25519": "deny",
      "*/id_ed25519": "deny",
      "id_ecdsa": "deny",
      "*/id_ecdsa": "deny",
      "id_dsa": "deny",
      "*/id_dsa": "deny",
      "credentials": "deny",
      "credentials/*": "deny",
      "*/credentials": "deny",
      "*/credentials/*": "deny",
      "secrets": "deny",
      "secrets/*": "deny",
      "*/secrets": "deny",
      "*/secrets/*": "deny",
      "token": "deny",
      "token/*": "deny",
      "*/token": "deny",
      "*/token/*": "deny",
      ".ssh": "deny",
      ".ssh/*": "deny",
      "*/.ssh": "deny",
      "*/.ssh/*": "deny",
      ".gnupg": "deny",
      ".gnupg/*": "deny",
      "*/.gnupg": "deny",
      "*/.gnupg/*": "deny",
      ".aws": "deny",
      ".aws/*": "deny",
      "*/.aws": "deny",
      "*/.aws/*": "deny",
      ".docker": "deny",
      ".docker/*": "deny",
      "*/.docker": "deny",
      "*/.docker/*": "deny",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/gh/hosts.yaml": "deny",
      ".config/gh/hosts.yml": "deny",
      ".config/gh/hosts.yaml": "deny",
      "*/.config/gh/hosts.yml": "deny",
      "*/.config/gh/hosts.yaml": "deny",
      "~/.cargo/credentials": "deny",
      "~/.cargo/credentials.toml": "deny",
      ".cargo/credentials": "deny",
      ".cargo/credentials.toml": "deny",
      "*/.cargo/credentials": "deny",
      "*/.cargo/credentials.toml": "deny",
      "~/.gem/credentials": "deny",
      ".gem/credentials": "deny",
      "*/.gem/credentials": "deny",
      "~/.kube/config": "deny",
      ".kube/config": "deny",
      "*/.kube/config": "deny"
