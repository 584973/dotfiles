{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "ls": "allow",
    "find": "allow",
    "read": "allow",
    "grep": "allow",
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow"
    },
    "bash": {
      "ls": "allow",
      "ls *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "npm list *": "allow",
      "which *": "allow",
      "command -v *": "allow"
    }
  }
}
