[
  {
    "context": "Workspace",
    "bindings": {
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space n": "pane::ActivateNextItem",
      "space p": "pane::ActivatePreviousItem",
      "space x": "pane::CloseActiveItem",
      "space z": "workspace::CloseAllDocks",
      "space f f": "file_finder::Toggle",
      "space f r": ["projects::OpenRecent", { "create_new_window": false }],
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f h": "command_palette::Toggle",
      "space t": "terminal_panel::ToggleFocus",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space n": "pane::ActivateNextItem",
      "space p": "pane::ActivatePreviousItem",
      "space x": "pane::CloseActiveItem",
      "space z": "workspace::CloseAllDocks",
      "space f f": "file_finder::Toggle",
      "space f r": ["projects::OpenRecent", { "create_new_window": false }],
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f h": "command_palette::Toggle",
      "space f m": "outline::Toggle",
      "space t": "terminal_panel::ToggleFocus",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space e": "project_panel::ToggleFocus",
      "g d": "editor::GoToDefinition",
      "space c a": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",
      "space g r": "editor::FindAllReferences",
      "space d e": "diagnostics::Deploy",
      "space d n": "editor::GoToDiagnostic",
      "space g f": "editor::Format",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "space y y": ["workspace::SendKeystrokes", "y y"],
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "space y": "editor::Copy",
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-l": "menu::Confirm",
      "right": "menu::Confirm",
    },
  },
  {
    "context": "Dock || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
]
